---
import general from '../data/general.json';

const { logo, footer } = general;
---

<footer class="bg-terza-cream px-6 py-14 lg:px-10">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-10 md:grid-cols-5">
    <div class="col-span-2 md:col-span-1">
      <p class="flex items-center gap-1 text-2xl font-semibold text-terza-ink">
        {logo.text}
        <span class="mb-3 h-2 w-2 rounded-[2px] bg-terza-lime"></span>
      </p>
      <p class="mt-3 max-w-[16ch] text-sm text-terza-ink/70">{footer.tagline}</p>
    </div>

    {footer.columns.map((col) => (
      <div>
        <p class="mb-3 text-sm font-semibold text-terza-ink">{col.title}</p>
        <ul class="space-y-2">
          {col.links.map((link: string) => (
            <li><a href="#" class="text-sm text-terza-ink/70 hover:text-terza-teal">{link}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <div>
      <div class="flex gap-3">
        {footer.social.map((s: string) => (
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-terza-teal text-[11px] font-semibold uppercase text-white">
            {s.slice(0, 2)}
          </span>
        ))}
      </div>
      <p class="mt-4 text-sm font-semibold text-terza-ink">{footer.copyright}</p>
    </div>
  </div>

  <div class="mx-auto mt-10 flex max-w-[1400px] flex-wrap gap-x-6 gap-y-2 border-t border-terza-ink/10 pt-6 text-xs text-terza-ink/60">
    {footer.legal.map((item: string) => <a href="#" class="hover:text-terza-teal">{item}</a>)}
  </div>
</footer>
