---
// Franja de cierre verde oscuro a todo el ancho, pegada al footer.
interface Props {
  title: string;
  cta: { label: string; href: string };
}

const { title, cta } = Astro.props;
---

<section class="bg-terza-teal">
  <div class="mx-auto flex max-w-[1728px] flex-col items-center gap-6 px-6 py-12 text-center text-white md:px-12 md:py-16 xl:px-[72px]">
    <h2 class="text-3xl font-bold md:text-4xl xl:text-5xl">{title}</h2>
    <a href={cta.href} class="inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
      {cta.label}
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>
