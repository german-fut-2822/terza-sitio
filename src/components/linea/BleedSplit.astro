---
// Fila texto + foto a todo el ancho: la foto se pega al borde de su lado, ocupa toda la altura
// y solo redondea las esquinas interiores (mismo patrón que ShawContract en el home).
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  imageSide?: 'left' | 'right';
  tone?: 'white' | 'mist' | 'teal';
  /** Las fotos de terza.com traen esquinas redondeadas: se amplían para ocultarlas */
  zoom?: boolean;
}

const { image, alt, imageSide = 'right', tone = 'white', zoom = true } = Astro.props;
const left = imageSide === 'left';
const tones = {
  white: '',
  mist: 'bg-terza-mist pt-12 lg:pt-0',
  teal: 'bg-terza-teal text-white pt-12 lg:pt-0',
};
---

<section class:list={['grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-0', tones[tone]]}>
  <div class:list={['px-6 md:px-12 lg:py-16 xl:px-[72px] xl:py-20', left && 'lg:order-2']}>
    <slot />
  </div>
  <div class:list={[
    'relative h-[320px] overflow-hidden md:h-[400px] lg:h-full lg:min-h-[480px] lg:self-stretch',
    tone === 'white' && 'shadow-[0_4px_18px_rgba(0,0,0,0.08)]',
    tone !== 'white' && 'mb-12 lg:mb-0',
    left ? 'mr-6 rounded-r-[32px] md:mr-12 lg:mr-0 xl:rounded-r-[56px]' : 'ml-6 rounded-l-[32px] md:ml-12 lg:ml-0 xl:rounded-l-[56px]',
  ]}>
    <Image src={image} alt={alt} class:list={['absolute inset-0 h-full w-full object-cover', zoom && 'scale-110']} />
  </div>
</section>
