---
// Tarjetas blancas con ícono, título y texto en 3 columnas (Beneficios, Cuidados...).
import { Image } from 'astro:assets';

interface Props {
  title: string;
  items: { icon: ImageMetadata; title: string; description: string }[];
  tone?: 'white' | 'mist' | 'lime';
}

const { title, items, tone = 'white' } = Astro.props;
const tones = { white: '', mist: 'bg-terza-mist', lime: 'bg-terza-lime-pale' };
---

<section class={tones[tone]}>
  <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
    <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
      {items.map((item) => (
        <div class="rounded-[28px] bg-white p-8 shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <div class="flex items-center gap-4">
            <Image src={item.icon} alt="" class="h-12 w-12 shrink-0 rounded-xl" width={96} height={96} />
            <h3 class="text-xl font-bold leading-tight text-terza-teal xl:text-2xl">{item.title}</h3>
          </div>
          <p class="mt-4 text-black xl:text-lg" set:html={item.description} />
        </div>
      ))}
    </div>
  </div>
</section>
