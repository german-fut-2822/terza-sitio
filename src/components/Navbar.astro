---
import { Image } from 'astro:assets';
import general from '../data/general.json';
import terzaLogo from '../assets/images/terza-logo.webp';

const { logo, nav } = general;
---

<header class="relative z-50 border-b border-terza-mist bg-white">
  <div class="mx-auto flex max-w-[1728px] items-center justify-between gap-4 px-6 py-4 md:px-10 xl:px-[45px] xl:py-7">
    <a href="/" class="flex items-center">
      <Image src={terzaLogo} alt={logo.text} class="h-8 w-auto xl:h-16" width={300} height={100} />
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {nav.map((cat) => (
        <div class="group">
          <button class="relative flex items-center gap-1.5 py-6 text-base font-medium text-terza-ink transition-colors group-hover:text-terza-teal xl:py-4 xl:text-lg">
            {cat.label}
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" class="mt-0.5 transition-transform group-hover:rotate-180">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <!-- Puente invisible para no perder el hover entre el botón y el panel -->
            <span class="absolute inset-x-0 top-full h-10" aria-hidden="true"></span>
          </button>

          <div
            class="invisible absolute inset-x-0 top-full border-y border-terza-mist bg-white opacity-0 shadow-xl transition-all duration-150 group-hover:visible group-hover:opacity-100"
            data-menu
          >
            <div class="mx-auto flex max-w-[1728px] gap-10 px-6 py-10 md:px-10 xl:gap-16 xl:px-[45px] xl:py-14">
              <div class="w-64 shrink-0 xl:w-80">
                <p class="mb-2 text-2xl font-bold text-terza-ink xl:text-3xl">{cat.label}</p>
                <p class="mb-6 text-sm text-terza-ink">{cat.description}</p>
                <nav class="space-y-1 pl-12 xl:pl-16">
                  {cat.groups.map((group, gi: number) => (
                    <button
                      type="button"
                      data-group-trigger
                      data-target={group.slug}
                      aria-current={gi === 0 ? 'true' : 'false'}
                      class:list={[
                        'menu-trigger flex w-full items-center justify-between py-2 text-left text-sm font-medium transition-colors hover:text-terza-teal xl:text-base',
                        gi === 0 ? 'is-active text-terza-teal' : 'text-terza-ink',
                      ]}
                    >
                      {group.label}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3.5L9 7L5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </button>
                  ))}
                </nav>
              </div>

              <div class="flex-1">
                {cat.groups.map((group, gi: number) => (
                  <div data-group-panel={group.slug} class:list={['flex flex-col', gi !== 0 && 'hidden']}>
                    <div class="grid grid-cols-4 gap-6 xl:gap-8">
                      {group.items.map((item: string) => (
                        <a href={`/${cat.slug}/${group.slug}`} class="group/card block">
                          <div class="aspect-[3/2] w-full rounded-2xl bg-terza-teal transition-transform group-hover/card:scale-[0.97]"></div>
                          <p class="mt-3 text-sm font-medium text-terza-teal xl:text-base">{item}</p>
                        </a>
                      ))}
                    </div>
                    <a href={`/${cat.slug}/${group.slug}`} class="mt-8 inline-flex w-fit items-center gap-3 self-end rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95 xl:text-lg">
                      Ver más
                      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-3 xl:gap-4">
      <button aria-label="Buscar" class="flex h-10 w-10 items-center justify-center rounded-full bg-terza-lime-light text-terza-teal xl:h-14 xl:w-14">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="xl:h-5 xl:w-5">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M16 16L12.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <a href="/contacto" class="hidden whitespace-nowrap rounded-full bg-terza-teal px-5 py-1.5 text-sm font-semibold text-white hover:bg-terza-teal-dark md:inline-block xl:px-8 xl:text-lg">
        Contáctanos
      </a>
      <a href="/quiero-ser-distribuidor" class="hidden whitespace-nowrap rounded-full bg-terza-lime px-5 py-1.5 text-sm font-semibold text-white hover:brightness-95 lg:inline-block xl:px-8 xl:text-lg">
        Quiero ser distribuidor
      </a>
      <button id="mobile-menu-toggle" aria-label="Menú" class="flex h-10 w-10 items-center justify-center lg:hidden">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <path d="M3 6H19M3 11H19M3 16H19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-terza-mist bg-white px-6 py-4 lg:hidden">
    <ul class="space-y-1">
      {nav.map((cat) => (
        <li>
          <a href={`/${cat.slug}`} class="block py-2 text-base font-medium text-terza-ink">{cat.label}</a>
        </li>
      ))}
      <li class="pt-3">
        <a href="/contacto" class="block rounded-full bg-terza-teal px-4 py-1.5 text-center text-sm font-semibold text-white">Contáctanos</a>
      </li>
      <li class="pt-2">
        <a href="/quiero-ser-distribuidor" class="block rounded-full bg-terza-lime px-4 py-1.5 text-center text-sm font-semibold text-white">Quiero ser distribuidor</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menuEl) => {
    const triggers = menuEl.querySelectorAll<HTMLElement>('[data-group-trigger]');
    const panels = menuEl.querySelectorAll<HTMLElement>('[data-group-panel]');

    const activate = (target: string | undefined) => {
      triggers.forEach((t) => {
        const active = t.dataset.target === target;
        t.classList.toggle('is-active', active);
        t.classList.toggle('text-terza-teal', active);
        t.classList.toggle('text-terza-ink', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.dataset.groupPanel !== target));
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('mouseenter', () => activate(trigger.dataset.target));
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        activate(trigger.dataset.target);
      });
    });
  });
</script>
