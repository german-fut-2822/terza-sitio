---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import FormHero from '../components/FormHero.astro';
import data from '../data/contacto.json';
import heroImg from '../assets/images/bg_contacto_terza.webp';
import buzonImg from '../assets/images/terza-contacto-buzon.png';
import bolsaImg from '../assets/images/terza-contacto-bolsa.png';

const { hero, form, links } = data;
const linkImages = [buzonImg, bolsaImg];
---

<Layout title={data.seo.title} description={data.seo.description}>
  <!-- La foto ya viene oscurecida, por eso va sin overlay -->
  <FormHero image={heroImg} alt="Sala Terza con vista a la montaña" imageClass="object-cover object-[30%_50%]" overlay={false} title={hero.title} description={hero.description} cta={hero.cta} form={form} />

  <!-- Banners: Buzón de Transparencia y Bolsa de trabajo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 gap-6 px-6 py-10 md:grid-cols-2 md:px-12 xl:px-[72px] xl:py-12">
    {links.map((link, i) => (
      <a href={link.href} class="group relative isolate flex h-[220px] items-end justify-end overflow-hidden rounded-[32px] p-5 md:h-[250px] xl:h-[280px]">
        <Image src={linkImages[i]} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={540} height={280} />
        <span class="rounded-2xl bg-terza-teal-dark px-7 py-3.5 text-sm font-bold text-white transition group-hover:bg-terza-teal">{link.title}</span>
      </a>
    ))}
  </section>
</Layout>
