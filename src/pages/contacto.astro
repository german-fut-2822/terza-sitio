---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ContactForm from '../components/ContactForm.astro';
import data from '../data/contacto.json';
import heroImg from '../assets/images/coleccion-bari.webp';
import portraitImg from '../assets/images/contacto-portrait.webp';
import showroomImg from '../assets/images/showroom-cubes.webp';

const { hero, form, links } = data;
---

<Layout title={data.seo.title} description={data.seo.description}>
  <section class="relative isolate flex min-h-[640px] items-center overflow-hidden">
    <Image src={heroImg} alt="Sala Terza con vista a la montaña" class="absolute inset-0 -z-10 h-full w-full object-cover" width={2000} height={1400} />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/35 to-black/10"></div>

    <div class="mx-auto grid w-full max-w-[1400px] grid-cols-1 gap-10 px-6 py-16 lg:grid-cols-2 lg:px-10">
      <div class="flex flex-col justify-center text-white">
        <h1 class="text-5xl font-bold">{hero.title}</h1>
        <p class="mt-3 max-w-xs text-white/85">{hero.description}</p>
        <a href={hero.cta.href} class="mt-6 inline-block w-fit rounded-full bg-terza-lime px-6 py-3 text-sm font-semibold text-terza-ink hover:brightness-95">
          {hero.cta.label} →
        </a>
      </div>
      <div class="flex items-center justify-center lg:justify-end">
        <ContactForm title={form.title} fields={form.fields} consent={form.consent} submit={form.submit} />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1400px] grid-cols-1 gap-5 px-6 py-14 md:grid-cols-2 lg:px-10">
    <a href={links[0].href} class="group relative flex min-h-[220px] items-end overflow-hidden rounded-3xl">
      <Image src={portraitImg} alt={links[0].title} class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={1200} height={800} />
      <div class="absolute inset-0 -z-10 bg-black/35"></div>
      <span class="m-5 rounded-full bg-terza-teal px-5 py-2.5 text-sm font-semibold text-white">{links[0].title}</span>
    </a>
    <a href={links[1].href} class="group relative flex min-h-[220px] items-end overflow-hidden rounded-3xl">
      <Image src={showroomImg} alt={links[1].title} class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={1200} height={800} />
      <div class="absolute inset-0 -z-10 bg-black/35"></div>
      <span class="m-5 rounded-full bg-terza-teal px-5 py-2.5 text-sm font-semibold text-white">{links[1].title}</span>
    </a>
  </section>
</Layout>
