---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ContactForm from '../components/ContactForm.astro';
import data from '../data/contacto.json';
import heroImg from '../assets/images/coleccion-bari.webp';
import buzonImg from '../assets/images/buzon-de-transparencia.webp';
import bolsaImg from '../assets/images/bolsa-de-trabajo.webp';

const { hero, form, links } = data;
---

<Layout title={data.seo.title} description={data.seo.description}>
  <section class="relative isolate flex min-h-[640px] items-center overflow-hidden xl:min-h-[966px]">
    <Image src={heroImg} alt="Sala Terza con vista a la montaña" class="absolute inset-0 -z-10 h-full w-full object-cover" width={2000} height={1400} />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/35 to-black/10"></div>

    <div class="mx-auto grid w-full max-w-[1728px] grid-cols-1 gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:px-[72px]">
      <div class="flex flex-col justify-center text-white">
        <h1 class="text-4xl font-bold md:text-5xl xl:text-7xl">{hero.title}</h1>
        <p class="mt-4 max-w-sm text-lg text-white/85">{hero.description}</p>
        <a href={hero.cta.href} class="mt-7 inline-block w-fit rounded-full bg-terza-lime px-7 py-3.5 text-base font-semibold text-terza-ink hover:brightness-95">
          {hero.cta.label} →
        </a>
      </div>
      <div class="flex items-center justify-center lg:justify-end">
        <ContactForm title={form.title} fields={form.fields} consent={form.consent} submit={form.submit} />
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1728px] grid-cols-1 gap-6 px-6 py-16 md:grid-cols-2 md:px-12 xl:px-[72px]">
    <a href={links[0].href} class="group relative flex min-h-[260px] items-end justify-end overflow-hidden rounded-3xl xl:min-h-[300px]">
      <Image src={buzonImg} alt={links[0].title} class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={750} height={682} />
      <span class="m-6 rounded-full bg-terza-teal px-6 py-3 text-base font-semibold text-white">{links[0].title}</span>
    </a>
    <a href={links[1].href} class="group relative flex min-h-[260px] items-end justify-end overflow-hidden rounded-3xl xl:min-h-[300px]">
      <Image src={bolsaImg} alt={links[1].title} class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={1400} height={460} />
      <span class="m-6 rounded-full bg-terza-teal px-6 py-3 text-base font-semibold text-white">{links[1].title}</span>
    </a>
  </section>
</Layout>
