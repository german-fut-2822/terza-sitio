---
import Layout from '../layouts/Layout.astro';
import FormHero from '../components/FormHero.astro';
import data from '../data/distribuidor.json';
import heroImg from '../assets/images/showroom-cubes.webp';

const { hero, form } = data;
---

<Layout title={data.seo.title} description={data.seo.description}>
  <!-- Encuadre en la parte alta del showroom: repisas de muestras, rack de colores y muro de duelas -->
  <FormHero image={heroImg} alt="Showroom Terza" imageClass="object-cover object-[50%_25%]" title={hero.title} description={hero.description} form={form} />
</Layout>
