---
// Misma estructura y textos que terza.com/muros-verdes, con el diseño de las páginas de línea (ver Deck y Lambrín).
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../components/linea/LineaHero.astro';
import BleedSplit from '../components/linea/BleedSplit.astro';
import ContactBand from '../components/linea/ContactBand.astro';
import FaqAccordion from '../components/linea/FaqAccordion.astro';
import data from '../data/follaje-artificial.json';
import heroImg from '../assets/images/follaje-artificial/header.jpg';
import catalogoImg from '../assets/images/cat-follaje-artificial.webp';

const { hero, intro, variedad, beneficios, catalogo, tips, oficina, faqs, cierre } = data;

// Fotos de terza.com/muros-verdes
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/images/follaje-artificial/*.webp', { eager: true });
const img = (name: string) => assets[`../assets/images/follaje-artificial/${name}.webp`].default;

// Las respuestas con viñetas o pasos vienen como lista; se pasan a HTML para FaqAccordion
type Faq = { q: string; a?: string; list?: string[]; ordered?: boolean };
const faqItems = (faqs.items as Faq[]).map((faq) => {
  const tag = faq.ordered ? 'ol' : 'ul';
  const list = faq.list ? `<${tag}>${faq.list.map((li) => `<li>${li}</li>`).join('')}</${tag}>` : '';
  return { q: faq.q, a: (faq.a ? `<p>${faq.a}</p>` : '') + list };
});

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
const btnLime = 'inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Mujer frente a un muro de follaje artificial Terza" title={hero.title} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl" set:html={intro.title} />
    <p class="mx-auto mt-5 max-w-[820px] text-lg text-black xl:text-xl">{intro.description}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel={cta.href.startsWith('http') ? 'noopener' : undefined} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- Conoce toda nuestra variedad -->
  <BleedSplit image={img('img-01')} alt="Mujer hablando por teléfono junto a un muro verde" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{variedad.title}</h2>
    <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl">{variedad.description}</p>
    <a href={variedad.cta.href} class:list={[btnLime, 'mt-8']}>{variedad.cta.label} <Fragment set:html={arrow} /></a>
  </BleedSplit>

  <!-- Beneficios: zigzag alternando gris -->
  <section class="pt-16 xl:pt-24">
    <h2 class="px-6 text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{beneficios.title}</h2>
    <div class="mt-12 flex flex-col gap-14 xl:mt-16 xl:gap-20">
      {beneficios.items.map((item, i) => (
        <BleedSplit image={img(item.image)} alt={item.alt} imageSide={i % 2 === 0 ? 'left' : 'right'} tone={i % 2 === 1 ? 'mist' : 'white'}>
          <h3 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{item.title}</h3>
          <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{item.description}</p>
        </BleedSplit>
      ))}
    </div>
  </section>

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <p class="mt-5 text-lg text-black xl:text-xl">{catalogo.description}</p>
      <a href={catalogo.cta.href} class:list={[btnLime, 'mt-8']}>{catalogo.cta.label} <Fragment set:html={arrow} /></a>
    </div>
    <Image src={catalogoImg} alt="Muro de follaje artificial Terza" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" />
  </section>

  <!-- Tips: tarjetas con foto -->
  <section class="bg-terza-mist">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
      <h2 class="text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl" set:html={tips.title} />
      <p class="mt-5 text-center text-lg text-black xl:text-xl">{tips.description}</p>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
        {tips.items.map((item) => (
          <article class="flex flex-col overflow-hidden rounded-[28px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
            <div class="overflow-hidden">
              <Image src={img(item.image)} alt={item.alt} class="aspect-[16/9] w-full scale-110 object-cover" />
            </div>
            <div class="p-7 xl:p-8">
              <h3 class="text-2xl font-bold leading-tight text-terza-teal">{item.title}</h3>
              <p class="mt-3 text-black xl:text-lg">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 flex justify-center">
        <a href={tips.cta.href} class={btnLime}>{tips.cta.label} <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- ¿Por qué instalar Green Walls en la oficina? -->
  <section class="flex flex-col pt-16 xl:pt-24">
    <h2 class="px-6 text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{oficina.title}</h2>
    <div class="mt-12 flex flex-col gap-14 xl:mt-16 xl:gap-20">
      {oficina.items.map((item, i) => (
        <BleedSplit image={img(item.image)} alt={item.alt} imageSide={i % 2 === 0 ? 'left' : 'right'}>
          <p class="max-w-xl text-lg text-black xl:text-xl">{item.description}</p>
        </BleedSplit>
      ))}
    </div>
    <a href={oficina.cta.href} class:list={[btnLime, 'mx-auto mt-14 xl:mt-20']}>{oficina.cta.label} <Fragment set:html={arrow} /></a>
  </section>

  <FaqAccordion title={faqs.title} items={faqItems} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
