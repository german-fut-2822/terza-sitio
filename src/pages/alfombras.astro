---
// Misma estructura y textos que terza.com/alfombras, con la línea de diseño del sitio.
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../components/linea/LineaHero.astro';
import BleedSplit from '../components/linea/BleedSplit.astro';
import IconCards from '../components/linea/IconCards.astro';
import FaqAccordion from '../components/linea/FaqAccordion.astro';
import ContactBand from '../components/linea/ContactBand.astro';
import data from '../data/alfombras.json';
import heroImg from '../assets/images/alfombras/header.jpg';
import catalogoImg from '../assets/images/cat-alfombras.webp';

const { hero, intro, porQue, conoceMas, espacios, espaciosCta, beneficios, cuidados, catalogo, mitos, faqs, cierre } = data;

// Fotos e íconos de terza.com/alfombras
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/images/alfombras/*.png', { eager: true });
const img = (name: string) => assets[`../assets/images/alfombras/${name}.png`].default;

const isExternal = (href: string) => href.startsWith('http');
const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Mujer recostada sobre una alfombra usando su laptop" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1000px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <p class="mt-5 text-lg text-black xl:text-xl">{intro.description}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={isExternal(cta.href) ? '_blank' : undefined} rel={isExternal(cta.href) ? 'noopener' : undefined}
          class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- ¿Por qué optar...? -->
  <BleedSplit image={img('img-01')} alt="Madre e hijo sobre una alfombra" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{porQue.title}</h2>
    {porQue.paragraphs.map((p) => <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl [&_strong]:text-terza-lime" set:html={p} />)}
  </BleedSplit>

  <!-- Conoce más (3 columnas) -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
    <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{conoceMas.title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
      {conoceMas.items.map((item) => (
        <div class="rounded-[28px] bg-white p-8 text-center shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <h3 class="text-xl font-bold text-terza-teal xl:text-2xl">{item.title}</h3>
          <p class="mt-3 text-black xl:text-lg">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Espacios en zigzag; recámaras (fila del medio) sobre el fondo de Blog | Ideas -->
  <section class="flex flex-col gap-14 pb-16 xl:gap-20 xl:pb-24">
    {espacios.map((esp, i) => (
      <BleedSplit image={img(esp.image)} alt={esp.title} imageSide={i % 2 === 0 ? 'left' : 'right'} tone={i === 1 ? 'mist' : 'white'}>
        <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{esp.title}</h2>
        <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{esp.description}</p>
      </BleedSplit>
    ))}
    <a href={espaciosCta.href} class="mx-auto inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
      {espaciosCta.label} <Fragment set:html={arrow} />
    </a>
  </section>

  <!-- Beneficios (caja verde claro) -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="rounded-[28px] bg-terza-lime-pale p-8 md:p-12 xl:p-16">
      <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{beneficios.title}</h2>
      <ul class="mx-auto mt-10 grid max-w-[1000px] grid-cols-1 gap-x-12 gap-y-5 md:grid-cols-2">
        {beneficios.items.map((b) => (
          <li class="flex items-center gap-4">
            <Image src={img(b.icon)} alt="" class="h-12 w-12 shrink-0 rounded-xl" width={96} height={96} />
            <span class="text-lg font-medium text-black xl:text-xl">{b.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="mt-16 xl:mt-24">
    <IconCards title={cuidados.title} items={cuidados.items.map((c) => ({ ...c, icon: img(c.icon) }))} tone="mist" />
  </div>

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <p class="mt-5 text-lg text-black xl:text-xl">{catalogo.description}</p>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={catalogoImg} alt="Alfombra Terza en una sala" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" width={1200} height={675} />
  </section>

  <!-- Mitos y realidades (video) -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="rounded-[28px] bg-terza-lime-pale px-6 py-12 text-center md:px-12 xl:py-16">
      <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{mitos.title}</h2>
      <p class="mt-4 text-lg text-black xl:text-xl">{mitos.description}</p>
      <div class="mt-10 flex justify-center">
        <iframe src={mitos.video} title={mitos.title} width="315" height="560" class="max-w-full rounded-[20px] border-0 shadow-[0_4px_18px_rgba(0,0,0,0.08)]" scrolling="no" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
