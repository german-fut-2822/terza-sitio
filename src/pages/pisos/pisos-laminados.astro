---
// Misma estructura y textos que terza.com/pisos-laminados, con el diseño de las páginas de línea (ver Deck y Lambrín).
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../../components/linea/LineaHero.astro';
import BleedSplit from '../../components/linea/BleedSplit.astro';
import IconCards from '../../components/linea/IconCards.astro';
import ContactBand from '../../components/linea/ContactBand.astro';
import FaqAccordion from '../../components/linea/FaqAccordion.astro';
import data from '../../data/pisos-laminados.json';
import heroImg from '../../assets/images/pisos-laminados/header.jpg';
import catalogoImg from '../../assets/images/cat-pisos-laminados.webp';

const { hero, intro, porQue, conoceMas, beneficios, cuidados, catalogo, disena, colecciones, faqs, cierre } = data;

// Fotos, íconos y muestras de terza.com/pisos-laminados
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/pisos-laminados/*.{png,jpg}', { eager: true });
const img = (name: string) => {
  const key = Object.keys(assets).find((k) => k.endsWith(`/pisos-laminados/${name}.png`) || k.endsWith(`/pisos-laminados/${name}.jpg`));
  return assets[key!].default;
};

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Pareja bailando sobre piso laminado Terza" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel={cta.href.startsWith('http') ? 'noopener' : undefined} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- ¿Por qué optar...? -->
  <BleedSplit image={img('img-01')} alt="Sala con piso laminado Terza" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{porQue.title}</h2>
    {porQue.paragraphs.map((p) => <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl">{p}</p>)}
  </BleedSplit>

  <!-- Conoce más: zigzag con la fila del medio en gris (la foto empieza a la izquierda, como en terza.com) -->
  <section class="pt-16 xl:pt-24">
    <h2 class="px-6 text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{conoceMas.title}</h2>
    <div class="mt-12 flex flex-col gap-14 xl:mt-16 xl:gap-20">
      {conoceMas.items.map((item, i) => (
        <BleedSplit image={img(item.image)} alt={item.alt} imageSide={i % 2 === 0 ? 'left' : 'right'} tone={i === 1 ? 'mist' : 'white'}>
          <h3 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{item.title}</h3>
          {item.paragraphs.map((p) => <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{p}</p>)}
        </BleedSplit>
      ))}
    </div>
  </section>

  <!-- Beneficios: franja verde claro con tarjetas blancas (como en Lambrín) -->
  <section class="mt-16 bg-terza-lime-pale xl:mt-24">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
      <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{beneficios.title}</h2>
      <ul class="mx-auto mt-10 grid max-w-[1200px] grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {beneficios.items.map((b) => (
          <li class="flex items-center gap-4 rounded-[20px] bg-white px-5 py-4 shadow-[0_4px_18px_rgba(0,0,0,0.06)]">
            <Image src={img(b.icon)} alt="" class="h-12 w-12 shrink-0" width={96} height={96} />
            <span class="text-lg font-medium text-black xl:text-xl">{b.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <IconCards title={cuidados.title} items={cuidados.items.map((c) => ({ ...c, icon: img(c.icon) }))} tone="mist" />

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <p class="mt-5 text-lg text-black xl:text-xl">{catalogo.description}</p>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={catalogoImg} alt="Piso laminado Terza en una sala" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" />
  </section>

  <!-- Diseña tu espacio: texto centrado sin caja -->
  <section class="mx-auto max-w-[1100px] px-6 pb-4 text-center md:px-12">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{disena.title}</h2>
    <p class="mx-auto mt-6 max-w-[820px] text-lg text-black xl:text-xl">{disena.description}</p>
  </section>

  <!-- Colecciones: un carrusel deslizable (scroll-snap, sin JS) por colección -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:pb-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 xl:gap-8">
      {colecciones.map((col) => (
        <div>
          <h3 class="text-center text-2xl font-bold text-black xl:text-3xl">{col.title}</h3>
          <div class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto rounded-[28px] pb-3 [scrollbar-width:thin]">
            {col.images.map((name, j) => (
              <Image src={img(name)} alt={`${col.title} — muestra ${j + 1}`} class="aspect-square w-full shrink-0 snap-center rounded-[28px] object-cover" width={350} height={350} />
            ))}
          </div>
          <p class="mt-2 text-center text-sm text-black/60">Desliza para ver más</p>
        </div>
      ))}
    </div>
  </section>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
