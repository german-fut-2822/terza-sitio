---
// Página de categoría: misma estructura y textos que terza.com/persianas, con el diseño de las páginas de línea (ver Deck y Lambrín).
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../components/linea/LineaHero.astro';
import BleedSplit from '../components/linea/BleedSplit.astro';
import IconCards from '../components/linea/IconCards.astro';
import ContactBand from '../components/linea/ContactBand.astro';
import FaqAccordion from '../components/linea/FaqAccordion.astro';
import data from '../data/persianas.json';
import heroImg from '../assets/images/persianas/header.jpg';
import catalogoImg from '../assets/images/cat-persianas.webp';

const { hero, intro, porQue, beneficios, tipos, cuidados, colecciones, motorizadas, catalogo, videos, faqs, cierre } = data;

// Fotos, logotipos e íconos de terza.com/persianas
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/images/persianas/*.png', { eager: true });
const img = (name: string) => assets[`../assets/images/persianas/${name}.png`].default;

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Sala con persianas Terza" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- ¿Por qué elegir...? -->
  <BleedSplit image={img('img-01')} alt="Hombre abriendo una persiana Terza" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{porQue.title}</h2>
    {porQue.paragraphs.map((p) => <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl">{p}</p>)}
  </BleedSplit>

  <!-- Beneficios: mismas tarjetas que IconCards (tone lime), sin ícono porque terza.com no lo trae -->
  <section class="mt-16 bg-terza-lime-pale xl:mt-24">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
      <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{beneficios.title}</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
        {beneficios.items.map((item) => (
          <div class="rounded-[28px] bg-white p-8 shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
            <h3 class="text-xl font-bold leading-tight text-terza-teal xl:text-2xl">{item.title}</h3>
            <p class="mt-4 text-black xl:text-lg">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tipos de persianas: tarjetas con foto -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
    <h2 class="text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{tipos.title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4 xl:gap-8">
      {tipos.items.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-[28px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <div class="overflow-hidden">
            <Image src={img(item.image)} alt={item.title} class="aspect-[4/3] w-full scale-110 object-cover" />
          </div>
          <div class="flex flex-1 flex-col p-7 xl:p-8">
            <h3 class="text-2xl font-bold leading-tight text-terza-teal">{item.title}</h3>
            <ul class="mt-4 space-y-2 text-black">
              {item.bullets.map((b) => (
                <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-terza-lime"></span><span>{b}</span></li>
              ))}
            </ul>
            <div class="mt-auto pt-7">
              <a href={item.cta.href} class="inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
                {item.cta.label} <Fragment set:html={arrow} />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <IconCards title={cuidados.title} items={cuidados.items.map((c) => ({ ...c, icon: img(c.icon) }))} tone="mist" />

  <!-- Colecciones: tarjetas con el logotipo de cada marca y su garantía -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
    <h2 class="mx-auto max-w-[1100px] text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{colecciones.title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4 xl:gap-8">
      {colecciones.items.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-[28px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <div class="overflow-hidden">
            <Image src={img(item.image)} alt={`Persianas ${item.name}`} class="aspect-[27/14] w-full scale-110 object-cover" />
          </div>
          <div class="p-7 xl:p-8">
            <p class="flex items-end gap-3">
              <span class="text-5xl font-bold leading-none text-terza-teal xl:text-6xl">{item.years}</span>
              <span class="text-xl font-bold leading-tight text-black xl:text-2xl">{item.label}</span>
            </p>
            <p class="mt-4 text-black xl:text-lg">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Persianas motorizadas: caja verde oscuro con el control -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="grid grid-cols-1 items-center gap-8 rounded-[28px] bg-terza-teal px-6 py-12 text-white md:px-12 lg:grid-cols-[1fr_auto] xl:px-16 xl:py-16">
      <div>
        <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{motorizadas.title}</h2>
        <p class="mt-5 text-lg text-white/85 xl:text-xl [&_strong]:text-terza-lime" set:html={motorizadas.lead} />
        <ul class="mt-6 space-y-2 text-lg text-white/85 xl:text-xl">
          {motorizadas.items.map((item) => (
            <li class="flex gap-3"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-terza-lime"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <Image src={img('control-somfy')} alt="Control Somfy para persianas motorizadas" class="mx-auto h-[280px] w-auto object-contain md:h-[360px]" width={472} height={720} />
    </div>
  </section>

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={catalogoImg} alt="Persianas Terza en una sala" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" width={1200} height={675} />
  </section>

  <!-- Instalación (videos) -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="rounded-[28px] bg-terza-lime-pale px-6 py-12 text-center md:px-12 xl:py-16">
      <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{videos.title}</h2>
      <div class="mx-auto mt-10 grid max-w-[1200px] grid-cols-1 gap-6 md:grid-cols-2 xl:gap-8">
        {videos.items.map((v) => (
          <iframe src={v.src} title={v.title} width="560" height="315" class="aspect-video w-full rounded-[20px] border-0 shadow-[0_4px_18px_rgba(0,0,0,0.08)]" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" loading="lazy"></iframe>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
