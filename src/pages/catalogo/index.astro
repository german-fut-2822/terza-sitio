---
// Catálogo: categorías agrupadas por sección (mismo orden que el menú). Datos traídos de la propuesta de rediseño.
import Layout from '../../layouts/Layout.astro';
import { secciones, productos, foto, urlCategoria } from '../../lib/catalogo';

const arrow = '<svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title="Catálogo de productos | Terza" description="Pisos, alfombras, muros, persianas, exterior y accesorios: explora todo el catálogo de Terza.">
  <section class="bg-terza-teal text-white">
    <div class="mx-auto max-w-[1728px] px-6 py-14 md:px-12 xl:px-[72px] xl:py-20">
      <nav class="text-sm text-white/70" aria-label="Ruta">
        <a href="/" class="hover:text-white">Inicio</a><span class="mx-2">/</span><span class="text-white">Catálogo</span>
      </nav>
      <h1 class="mt-6 text-5xl font-bold leading-none md:text-6xl xl:text-7xl">Catálogo de productos</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85 xl:text-xl">
        {productos.length} productos en pisos, alfombras, muros, persianas, exterior y accesorios. Elige una categoría para ver colores, medidas y fichas técnicas.
      </p>
      <!-- Accesos rápidos a cada sección -->
      <ul class="mt-8 flex flex-wrap gap-2">
        {secciones.map((sec) => (
          <li><a href={`#${sec.id}`} class="inline-flex rounded-full border border-white/30 px-5 py-1.5 text-sm font-medium transition-colors hover:border-terza-lime hover:bg-terza-lime hover:text-terza-ink">{sec.nombre}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {secciones.map((sec, i) => (
    <section id={sec.id} class:list={['scroll-mt-6', i % 2 === 1 && 'bg-terza-mist']}>
      <div class="mx-auto max-w-[1728px] px-6 py-14 md:px-12 xl:px-[72px] xl:py-20">
        <div class="flex items-end justify-between gap-6">
          <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{sec.nombre}</h2>
          <p class="shrink-0 text-sm font-medium text-terza-teal xl:text-base">{sec.categorias.reduce((n, c) => n + c.total, 0)} productos</p>
        </div>
        <!-- Mismo estilo que las tarjetas de producto (src/components/catalogo/ProductCard.astro) -->
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8">
          {sec.categorias.map((cat) => (
            <a href={urlCategoria(cat.slug)} class="group flex h-full flex-col overflow-hidden rounded-[24px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)] transition-shadow hover:shadow-[0_10px_30px_rgba(0,0,0,0.14)]">
              <div class="relative aspect-square overflow-hidden bg-terza-mist">
                {cat.portada && <img src={foto(cat.portada)} alt={cat.nombre} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />}
              </div>
              <div class="flex flex-1 items-end justify-between gap-3 p-4 md:p-5">
                <div class="min-w-0 self-start">
                  <p class="truncate text-xs font-bold uppercase tracking-widest text-terza-teal">{cat.total} productos</p>
                  <h3 class="mt-1 text-base font-medium leading-snug text-black md:text-lg">{cat.nombre}</h3>
                  <p class="mt-1 text-sm text-black/70">{cat.intro}</p>
                </div>
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-terza-mist text-terza-teal transition-colors group-hover:bg-terza-lime group-hover:text-terza-ink" aria-hidden="true" set:html={arrow} />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Layout>
