---
// Listado de una categoría: barra lateral con categorías y filtros, y cuadrícula de productos.
// Los filtros se aplican en el navegador y se guardan en la URL (?estilo=Bilbao) para compartirla.
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/catalogo/ProductCard.astro';
import { categorias, secciones, categoriaDe, productosDe, opcionesDe, urlCategoria, foto, paginasLinea } from '../../../lib/catalogo';

export function getStaticPaths() {
  return categorias.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = categoriaDe(categoria!);
const lista = productosDe(cat.slug);
const filtros = opcionesDe(cat.slug);
const linea = paginasLinea[cat.slug];

const chevron = '<svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M5 8L11 14L17 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
const cross = '<svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>';
const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={`${cat.nombre} | Catálogo Terza`} description={cat.intro}>
  <!-- Encabezado de la categoría -->
  <!-- Texto a la izquierda; la portada se pega al borde derecho a toda la altura (como ShawContract en el home) -->
  <section class="grid bg-terza-teal text-white lg:grid-cols-[minmax(0,1fr)_minmax(0,40%)]">
    <div class="px-6 py-12 md:px-12 xl:px-[72px] xl:py-16">
        <nav class="text-sm text-white/70" aria-label="Ruta">
          <a href="/" class="hover:text-white">Inicio</a><span class="mx-2">/</span>
          <a href="/catalogo" class="hover:text-white">Catálogo</a><span class="mx-2">/</span>
          <span class="text-white">{cat.nombre}</span>
        </nav>
        <p class="mt-6 text-sm font-bold uppercase tracking-widest text-terza-lime">{cat.seccion}</p>
        <h1 class="mt-2 text-5xl font-bold leading-none md:text-6xl">{cat.nombre}</h1>
        <p class="mt-5 max-w-2xl text-lg text-white/85 xl:text-xl">{cat.intro}</p>
        {linea && (
          <a href={linea.href} class="mt-7 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
            {linea.etiqueta} <Fragment set:html={arrow} />
          </a>
        )}
    </div>
    {cat.portada && (
      <div class="relative hidden overflow-hidden rounded-l-[32px] lg:block xl:rounded-l-[56px]">
        <img src={foto(cat.portada)} alt="" class="absolute inset-0 h-full w-full object-cover" />
      </div>
    )}
  </section>

  <section class="mx-auto grid max-w-[1728px] gap-10 px-6 py-12 md:px-12 lg:grid-cols-[270px_1fr] xl:px-[72px] xl:py-16">
    <!-- Barra lateral: en móvil se abre como panel con el botón "Filtros" -->
    <aside id="catalog-filters" class="fixed inset-0 z-[95] hidden overflow-y-auto bg-white px-6 pb-10 pt-6 lg:static lg:z-auto lg:block lg:overflow-visible lg:p-0" aria-label="Categorías y filtros">
      <div class="mb-6 flex items-center justify-between lg:hidden">
        <p class="text-xl font-bold text-black">Filtrar productos</p>
        <button type="button" class="filters-close flex h-11 w-11 items-center justify-center rounded-full bg-terza-mist text-terza-ink" aria-label="Cerrar filtros" set:html={cross} />
      </div>

      <div class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto lg:pr-2">
        <!-- Categorías: se elige la línea y abajo aparecen sus categorías -->
        <div class="mb-10">
          <p class="border-b border-black/10 pb-3 text-xs font-bold uppercase tracking-widest text-terza-teal">Categorías</p>
          <label class="relative mt-5 block">
            <span class="sr-only">Línea de producto</span>
            <select class="seccion-select w-full cursor-pointer appearance-none rounded-full border border-black/15 bg-white py-2.5 pl-5 pr-11 text-sm font-medium text-black focus:border-terza-teal focus:outline-none">
              {secciones.map((sec) => <option value={sec.id} selected={sec.nombre === cat.seccion}>{sec.nombre}</option>)}
            </select>
            <span class="pointer-events-none absolute right-5 top-1/2 -translate-y-1/2 text-terza-teal" set:html={chevron} />
          </label>
          {secciones.map((sec) => (
            <ul class:list={['seccion-lista mt-3 space-y-1', sec.nombre !== cat.seccion && 'hidden']} data-seccion={sec.id}>
              {sec.categorias.map((c) => (
                <li>
                  <a
                    href={urlCategoria(c.slug)}
                    class:list={['flex items-center justify-between rounded-xl px-3 py-2 text-sm transition-colors', c.slug === cat.slug ? 'bg-terza-lime-pale font-bold text-terza-teal' : 'text-black/70 hover:text-terza-teal']}
                    aria-current={c.slug === cat.slug ? 'page' : undefined}
                  >
                    {c.nombre} <span class="text-xs text-black/40">{c.total}</span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>

        <!-- Filtros: empiezan cerrados -->
        {filtros.length > 0 && (
          <div>
            <div class="flex items-center justify-between border-b border-black/10 pb-3">
              <p class="text-xs font-bold uppercase tracking-widest text-terza-teal">Filtros</p>
              <button type="button" class="filters-clear text-xs font-bold text-terza-teal hover:underline">Borrar</button>
            </div>
            {filtros.map((f) => (
              <details class="group/f border-b border-black/10">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-sm font-bold text-black [&::-webkit-details-marker]:hidden">
                  {f.etiqueta}
                  <span class="text-terza-teal transition-transform group-open/f:rotate-180" set:html={chevron} />
                </summary>
                <ul class="max-h-72 space-y-2.5 overflow-y-auto pb-5 pr-1">
                  {f.opciones.map((o) => (
                    <li>
                      <label class="flex cursor-pointer items-center gap-3 text-sm text-black/70 hover:text-black">
                        <input type="checkbox" class="filter-input h-4 w-4 accent-terza-teal" data-campo={f.campo} value={o.valor} />
                        <span class="flex-1">{o.valor}</span>
                        <span class="text-xs text-black/40">{o.total}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        )}
      </div>

      <!-- Móvil: cerrar el panel y ver los resultados -->
      <div class="sticky bottom-0 -mx-6 mt-8 border-t border-black/10 bg-white px-6 py-4 lg:hidden">
        <button type="button" class="filters-close inline-flex w-full items-center justify-center rounded-full bg-terza-lime px-7 py-2 text-base font-bold text-terza-ink">Ver <span class="results-count-mobile mx-1"></span> productos</button>
      </div>
    </aside>

    <!-- Productos -->
    <div>
      <div class="flex items-center justify-between gap-4 border-b border-black/10 pb-4">
        <p class="text-sm text-black/70"><span class="results-count font-bold text-black">{lista.length}</span> productos</p>
        {filtros.length > 0 && (
          <button type="button" class="filters-open inline-flex items-center gap-2 rounded-full bg-terza-teal px-5 py-1.5 text-sm font-bold text-white lg:hidden" aria-controls="catalog-filters">
            Filtros <span class="filters-badge hidden rounded-full bg-terza-lime px-2 text-xs text-terza-ink"></span>
          </button>
        )}
      </div>
      <div class="active-chips mt-4 flex flex-wrap gap-2 empty:hidden"></div>

      <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6 2xl:grid-cols-4">
        {lista.map((p) => <ProductCard producto={p} />)}
      </div>
      <p class="no-results mt-10 hidden text-center text-black/70">
        No hay productos con esa combinación de filtros.
        <button type="button" class="filters-clear font-bold text-terza-teal hover:underline">Borrar filtros</button>
      </p>
    </div>
  </section>
</Layout>

<script>
  const inputs = [...document.querySelectorAll<HTMLInputElement>('.filter-input')];
  const cards = [...document.querySelectorAll<HTMLElement>('.product-card')];
  const count = document.querySelector('.results-count')!;
  const empty = document.querySelector('.no-results')!;
  const chips = document.querySelector<HTMLElement>('.active-chips')!;
  const badge = document.querySelector('.filters-badge');
  const aside = document.getElementById('catalog-filters')!;
  const normalizar = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
  const datasetKey = (campo: string) => `f${campo[0].toUpperCase()}${campo.slice(1)}`;

  const aplicar = () => {
    // Dentro de un mismo filtro se suman opciones (O); entre filtros distintos se cruzan (Y)
    const activos: Record<string, string[]> = {};
    inputs.filter((i) => i.checked).forEach((i) => (activos[i.dataset.campo!] ??= []).push(i.value));
    let visibles = 0;
    cards.forEach((card) => {
      const ok = Object.entries(activos).every(([campo, valores]) => valores.includes(card.dataset[datasetKey(campo)] ?? ''));
      card.hidden = !ok;
      if (ok) visibles++;
    });
    count.textContent = String(visibles);
    document.querySelectorAll('.results-count-mobile').forEach((el) => { el.textContent = String(visibles); });
    empty.classList.toggle('hidden', visibles > 0);
    const total = Object.values(activos).flat().length;
    if (badge) { badge.textContent = String(total); badge.classList.toggle('hidden', !total); }
    chips.innerHTML = inputs.filter((i) => i.checked).map((i) => `
      <button type="button" class="chip inline-flex items-center gap-2 rounded-full bg-terza-lime-pale px-3 py-1.5 text-xs font-bold text-terza-teal" data-campo="${i.dataset.campo}" data-valor="${i.value}">
        ${i.value} <span aria-hidden="true">✕</span>
      </button>`).join('');
    // Guardar los filtros en la URL para poder compartirla
    const params = new URLSearchParams();
    Object.entries(activos).forEach(([campo, valores]) => params.set(campo, valores.join('|')));
    history.replaceState(null, '', params.toString() ? `?${params}` : location.pathname);
  };

  // Filtros que llegan en la URL (p. ej. desde el menú): se aceptan nombres parciales, ?estilo=Guerrero
  new URLSearchParams(location.search).forEach((valor, campo) => {
    valor.split('|').forEach((v) => {
      const buscado = normalizar(v);
      const delCampo = inputs.filter((i) => i.dataset.campo === campo);
      const exactos = delCampo.filter((i) => normalizar(i.value) === buscado);
      (exactos.length ? exactos : delCampo.filter((i) => normalizar(i.value).startsWith(buscado))).forEach((i) => { i.checked = true; });
    });
  });

  inputs.forEach((i) => i.addEventListener('change', aplicar));
  document.querySelectorAll('.filters-clear').forEach((b) => b.addEventListener('click', () => { inputs.forEach((i) => { i.checked = false; }); aplicar(); }));
  chips.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.chip');
    if (!chip) return;
    const input = inputs.find((i) => i.dataset.campo === chip.dataset.campo && i.value === chip.dataset.valor);
    if (input) input.checked = false;
    aplicar();
  });

  // Selector de línea: muestra las categorías de la línea elegida
  const listas = document.querySelectorAll<HTMLElement>('.seccion-lista');
  document.querySelector<HTMLSelectElement>('.seccion-select')!.addEventListener('change', (e) => {
    const valor = (e.target as HTMLSelectElement).value;
    listas.forEach((l) => l.classList.toggle('hidden', l.dataset.seccion !== valor));
  });

  // Panel de filtros en móvil
  const abrir = () => { aside.classList.remove('hidden'); document.documentElement.style.overflow = 'hidden'; };
  const cerrar = () => { aside.classList.add('hidden'); document.documentElement.style.overflow = ''; };
  document.querySelector('.filters-open')?.addEventListener('click', abrir);
  document.querySelectorAll('.filters-close').forEach((b) => b.addEventListener('click', cerrar));

  aplicar();
</script>
