---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import home from '../data/homepage.json';

import heroFlexiroc from '../assets/images/hero-flexiroc-live.webp';
import logoFlexiroc from '../assets/images/logo-flexiroc.webp';
import logoFlexirocDots from '../assets/images/logo-flexiroc-dots.webp';
import transformarEspacios from '../assets/images/transformar-espacios.webp';
import decoradorTerza from '../assets/images/decorador-virtual-terza.webp';
import decoradorMuestras from '../assets/images/decorador-virtual-muestras.webp';
import shawWorkplace from '../assets/images/cat-shaw-workplace.webp';
import shawHospitality from '../assets/images/cat-shaw-hospitality.webp';
import shawEducation from '../assets/images/cat-shaw-education.webp';
import shawHealthcare from '../assets/images/cat-shaw-healthcare.webp';
import shawLounge from '../assets/images/shawcontract-lounge.webp';
import contactoPortrait from '../assets/images/contacto-portrait.webp';
import showroomCubes from '../assets/images/showroom-cubes.webp';
import swatchArenisca from '../assets/images/swatch-arenisca.webp';
import swatchCaliza from '../assets/images/swatch-caliza.webp';
import swatchTravertino from '../assets/images/swatch-travertino.webp';
import swatchTerra from '../assets/images/swatch-terra.webp';
import blogPisos from '../assets/images/blog-pisos.webp';
import blogTips from '../assets/images/blog-tips.webp';
import blogMuros from '../assets/images/blog-muros.webp';
import distribuidorMateriales from '../assets/images/distribuidor-materiales.webp';

const swatchImages = [swatchArenisca, swatchCaliza, swatchTravertino, swatchTerra];
const shawSegmentImages: Record<string, ImageMetadata> = {
  Workplace: shawWorkplace,
  Hospitality: shawHospitality,
  Education: shawEducation,
  Healthcare: shawHealthcare,
};
const blogImages: Record<string, ImageMetadata> = {
  PISOS: blogPisos,
  TIPS: blogTips,
  MUROS: blogMuros,
};

const { hero, nuevosProductos, transformarEspacios: transformar, decoradorVirtual, shawContract, blog, ctaDistribuidor, contactoTeaser, ubicacionesTeaser } = home;
---

<Layout title="Terza | Fabricante de pisos, muros, persianas y exterior">
  <!-- Hero -->
  <section class="relative isolate flex h-[70vh] max-h-[560px] min-h-[380px] items-end overflow-hidden">
    <Image src={heroFlexiroc} alt="Flexiroc, recubrimiento de piedra flexible" class="absolute inset-0 -z-10 h-full w-full object-cover" width={2400} height={1400} />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/55 via-black/25 to-transparent"></div>

    <div class="mx-auto w-full max-w-[1728px] px-6 pb-8 pt-10 md:pb-10 lg:px-12 xl:pb-12 xl:pt-14 xl:pl-[296px]">
      <span class="mb-4 inline-block rounded-full bg-terza-teal px-5 py-2.5 text-sm font-semibold uppercase tracking-wide text-white">
        {hero.badge}
      </span>
      <div class="mb-2 flex items-center gap-2.5">
        <Image src={logoFlexirocDots} alt="" class="h-[28px] w-auto" width={75} height={26} />
        <span class="text-sm font-medium uppercase tracking-wide text-white/80">{hero.eyebrow}</span>
      </div>
      <Image src={logoFlexiroc} alt="flexiROC" class="-ml-1 h-20 w-auto sm:h-24 md:h-32 xl:h-[205px]" width={960} height={439} />
      <p class="mt-2 max-w-xs text-xl text-white/90 xl:text-2xl">{hero.subtitle}</p>
      <a href={hero.cta.href} class="mt-7 inline-block rounded-full bg-terza-lime px-8 py-4 text-lg font-semibold text-terza-ink hover:brightness-95">
        {hero.cta.label}
      </a>
    </div>
  </section>

  <!-- Nuevos productos -->
  <section class="mx-auto max-w-[1728px] px-6 py-10 md:px-12 xl:px-[72px] xl:py-12">
    <h2 class="mb-7 text-3xl font-bold text-terza-ink md:text-4xl">{nuevosProductos.title}</h2>
    <div class="grid grid-cols-2 gap-5 md:grid-cols-5 xl:gap-6">
      <a href={nuevosProductos.featured.href} class="group relative col-span-2 flex min-h-[358px] flex-col justify-end overflow-hidden rounded-2xl p-5 text-white md:col-span-1">
        <Image src={transformarEspacios} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={600} height={716} />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/35 to-black/5"></div>
        <Image src={logoFlexiroc} alt={nuevosProductos.featured.title} class="h-10 w-auto self-start" width={960} height={439} />
        <p class="mt-2 text-sm text-white/85">{nuevosProductos.featured.subtitle}</p>
        <span class="mt-5 inline-flex w-fit items-center gap-2 rounded-full bg-terza-teal px-4 py-2 text-sm font-semibold">Ver todo →</span>
      </a>
      {nuevosProductos.items.map((item: { name: string; sku: string }, i: number) => (
        <div class="relative flex flex-col overflow-visible rounded-2xl border border-terza-mist bg-white">
          <div class="relative isolate h-[220px] overflow-hidden rounded-t-2xl p-3 xl:h-[248px]">
            <Image src={swatchImages[i % 4]} alt={item.name} class="absolute inset-0 -z-10 h-full w-full object-cover" width={400} height={400} />
            <span class="inline-block rounded-full bg-terza-lime px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-terza-ink">Nuevo</span>
          </div>
          <div class="absolute left-3 top-[184px] h-[72px] w-[72px] overflow-hidden rounded-xl border-[3px] border-white shadow-sm xl:top-[212px]">
            <Image src={swatchImages[i % 4]} alt="" class="h-full w-full scale-150 object-cover" width={150} height={150} />
          </div>
          <div class="px-4 pb-4 pt-12">
            <p class="font-semibold text-terza-ink">{item.name}</p>
            <p class="mt-1 text-sm text-terza-ink/50">{item.sku}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Todo para transformar tus espacios -->
  <section class="relative isolate flex min-h-[640px] flex-col justify-between overflow-hidden md:min-h-[600px] md:justify-start xl:min-h-[660px]">
    <!-- Capa 1: fondo -->
    <Image src={transformarEspacios} alt="Sala con vista a la montaña, piso de madera Terza" class="absolute inset-y-0 left-0 z-0 h-full w-full max-w-none object-cover md:w-[122%]" width={2000} height={1200} />

    <!-- Capa 2: difuminado blanco + texto -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-full bg-gradient-to-r from-white via-white/80 to-transparent md:w-[62%] xl:w-[55%]"></div>

    <div class="relative z-10 flex flex-col gap-5 px-6 py-10 md:w-[58%] md:px-12 md:pt-12 xl:w-[44%] xl:pl-16 xl:pr-8 xl:pt-14">
      <h2 class="max-w-[210px] text-3xl font-bold leading-[1.15] text-terza-ink md:max-w-[240px] md:text-4xl xl:max-w-[300px] xl:text-[44px]">{transformar.title}</h2>
      <p class="max-w-[220px] text-terza-ink/70 xl:max-w-[240px]">{transformar.description}</p>
      <a href={transformar.cta.href} class="inline-flex w-fit items-center justify-center rounded-full bg-terza-lime px-8 py-3 text-base font-semibold text-terza-ink hover:brightness-95 xl:h-[78px] xl:w-[396px] xl:px-0 xl:text-lg">
        {transformar.cta.label} →
      </a>
    </div>

    <!-- Capa 3: tarjeta verde + badge -->
    <div class="relative z-20 flex flex-col gap-6 bg-[#0e483f]/50 px-6 py-7 text-white md:absolute md:inset-x-0 md:bottom-0 md:left-[38%] md:flex-row md:items-center md:gap-14 md:rounded-tl-[32px] md:px-12 md:py-8 xl:gap-20 xl:rounded-tl-[48px] xl:px-[72px] xl:py-[70px]">
      <div class="relative h-10 w-24 shrink-0 md:w-[200px] xl:w-[260px]">
        <div class="absolute left-0 top-0 flex h-24 w-24 flex-col items-center justify-center rounded-full bg-terza-lime text-center text-terza-teal md:-left-16 md:-top-[150px] md:h-[200px] md:w-[200px] xl:-left-24 xl:-top-[195px] xl:h-[260px] xl:w-[260px]">
          <span class="text-lg font-extrabold leading-none md:text-2xl xl:text-3xl">{transformar.stat.value.split(' ')[0]}</span>
          <span class="text-lg font-extrabold leading-none md:text-2xl xl:text-3xl">{transformar.stat.value.split(' ')[1]}</span>
          <span class="mt-1 text-[9px] text-terza-teal/80 md:text-sm xl:text-base">{transformar.stat.label}</span>
        </div>
      </div>
      {transformar.highlights.map((h: { title: string; description: string }) => (
        <div class="max-w-[220px] border-t border-white/20 pt-4 md:max-w-[260px] md:border-l md:border-t-0 md:pl-10 md:pt-0 xl:max-w-xs xl:pl-10">
          <p class="text-xl font-bold text-white xl:text-2xl">{h.title}</p>
          <p class="mt-1 text-white/75">{h.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Decorador virtual -->
  <section class="grid grid-cols-1 items-center bg-terza-lime-pale lg:grid-cols-12">
    <Image src={decoradorTerza} alt="Decorador Virtual Terza en un celular" class="h-full min-h-[360px] w-full object-cover object-bottom lg:col-span-6 lg:rounded-r-[32px] xl:rounded-r-[56px]" width={1200} height={900} />
    <div class="flex flex-col gap-4 px-6 py-10 md:px-12 lg:col-span-3 lg:px-8 xl:px-10 xl:py-14">
      <p class="text-sm font-semibold uppercase tracking-wider text-terza-teal">{decoradorVirtual.eyebrow}</p>
      <h2 class="max-w-sm text-3xl font-bold leading-tight text-terza-ink md:text-4xl">{decoradorVirtual.title}</h2>
      <p class="max-w-xs text-terza-ink/70">{decoradorVirtual.description}</p>
      <a href={decoradorVirtual.cta.href} class="mt-3 inline-flex w-fit items-center gap-2 rounded-full bg-terza-lime px-6 py-3 text-sm font-bold text-terza-ink hover:brightness-95">
        {decoradorVirtual.cta.label} →
      </a>
    </div>
    <div class="flex items-center justify-center px-6 py-10 lg:col-span-3 lg:px-6 xl:px-10">
      <Image src={decoradorMuestras} alt="Muestras del Decorador Virtual" class="w-full max-w-[320px] xl:max-w-[380px]" width={600} height={600} />
    </div>
  </section>

  <!-- ShawContract -->
  <section class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
    <div class="px-6 py-10 md:px-12 xl:px-[72px] xl:py-14">
      <h2 class="text-4xl font-bold text-terza-ink md:text-5xl">
        {shawContract.title.replace('®', '')}<sup class="text-lg font-normal md:text-xl">®</sup>
      </h2>
      <p class="mt-4 max-w-md text-lg text-terza-ink/70">{shawContract.description}</p>
      <a href={shawContract.cta.href} class="mt-7 inline-flex items-center gap-2 rounded-full bg-terza-teal px-6 py-3 text-sm font-semibold text-white hover:bg-terza-teal-dark">
        {shawContract.cta.label} →
      </a>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {shawContract.segments.map((seg: string) => (
          <div>
            <Image src={shawSegmentImages[seg]} alt={`ShawContract ${seg}`} class="aspect-square w-full rounded-2xl object-cover" width={300} height={300} />
            <p class="mt-2.5 text-xs font-bold uppercase tracking-widest text-terza-ink">{seg}</p>
          </div>
        ))}
      </div>
    </div>
    <Image src={shawLounge} alt="ShawContract lounge corporativo" class="h-full min-h-[360px] w-full rounded-l-[32px] object-cover xl:rounded-l-[56px]" width={1600} height={1200} />
  </section>

  <!-- Blog / Ideas -->
  <section class="bg-terza-mist px-6 py-10 md:px-12 xl:px-[72px] xl:py-14">
    <div class="mx-auto max-w-[1728px]">
      <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terza-teal">{blog.eyebrow}</p>
          <h2 class="mt-2 text-3xl font-bold text-terza-ink md:text-4xl">{blog.title}</h2>
        </div>
        <p class="max-w-xs text-sm text-terza-ink/60">{blog.description}</p>
        <a href={blog.cta.href} class="whitespace-nowrap rounded-full bg-terza-lime px-6 py-3 text-sm font-bold text-terza-ink hover:brightness-95">
          {blog.cta.label} →
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {blog.posts.map((post: { category: string; title: string }) => (
          <div class="overflow-hidden rounded-3xl bg-white">
            <Image src={blogImages[post.category]} alt={post.title} class="h-56 w-full object-cover" width={700} height={450} />
            <div class="p-5">
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-bold uppercase tracking-wider text-terza-teal">{post.category}</p>
                <span class="shrink-0 text-xl text-terza-ink">→</span>
              </div>
              <p class="mt-2 text-sm font-bold leading-snug text-terza-ink">{post.title}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA distribuidor -->
  <section class="relative overflow-hidden bg-terza-teal px-6 py-8 text-white md:px-12 xl:px-[72px] xl:py-10">
    <Image src={distribuidorMateriales} alt="" class="pointer-events-none absolute inset-y-4 left-4 hidden w-[240px] rounded-2xl object-cover md:block" width={857} height={710} />
    <div class="mx-auto flex max-w-[1728px] flex-col gap-8 lg:flex-row lg:items-center lg:justify-between md:pl-[260px]">
      <div class="max-w-md">
        <h2 class="text-2xl font-bold leading-tight md:text-3xl xl:text-4xl">
          {ctaDistribuidor.title.split(' distribuidor ')[0]}<br />
          <span class="text-terza-lime">distribuidor {ctaDistribuidor.title.split(' distribuidor ')[1]}</span>
        </h2>
        <p class="mt-2 text-sm text-white/80">{ctaDistribuidor.description}</p>
      </div>
      <div class="flex flex-wrap gap-8">
        {ctaDistribuidor.stats.map((s: { value: string; label: string }) => (
          <div class="max-w-[150px] border-l border-white/20 px-6 first:pl-0">
            {/^[+\d]/.test(s.value) ? (
              <>
                <p class="text-xl font-bold text-terza-lime">{s.value}</p>
                <p class="text-sm text-white/80">{s.label}</p>
              </>
            ) : (
              <p class="text-sm text-white/90">{s.value} {s.label}</p>
            )}
          </div>
        ))}
      </div>
      <a href={ctaDistribuidor.cta.href} class="inline-flex w-fit items-center gap-2 rounded-full bg-terza-lime px-7 py-3.5 text-base font-bold text-terza-ink hover:brightness-95">
        {ctaDistribuidor.cta.label} →
      </a>
    </div>
  </section>

  <!-- Contacto + Ubicaciones teaser -->
  <section class="grid grid-cols-1 md:grid-cols-2">
    <div class="relative flex min-h-[420px] items-stretch overflow-hidden bg-gradient-to-r from-white via-[#e8f7cc] to-[#c2e812] xl:min-h-[480px]">
      <div class="relative hidden w-[32%] shrink-0 sm:block xl:w-[30%]">
        <Image src={contactoPortrait} alt="Equipo Terza" class="h-full w-full object-cover object-[35%_bottom]" width={1200} height={900} />
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[#e8f7cc]"></div>
      </div>
      <div class="flex flex-1 flex-col justify-center p-8 md:p-12 xl:px-14">
        <p class="text-xs font-bold uppercase tracking-widest text-terza-teal">{contactoTeaser.eyebrow}</p>
        <h2 class="mt-2 max-w-xs text-3xl font-bold leading-[1.15] text-terza-teal md:text-4xl xl:text-5xl">{contactoTeaser.title}</h2>
        <p class="mt-3 max-w-xs text-sm text-terza-ink/70">{contactoTeaser.description}</p>
        <a href={contactoTeaser.cta.href} class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-terza-teal px-6 py-2.5 text-sm font-semibold text-white hover:bg-terza-teal-dark">
          {contactoTeaser.cta.label} →
        </a>
      </div>
    </div>
    <div class="relative flex min-h-[420px] items-center overflow-hidden bg-terza-mist p-8 md:p-12 xl:min-h-[480px] xl:px-[72px]">
      <Image src={showroomCubes} alt="Showroom Terza" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-90" width={1400} height={1000} />
      <div class="absolute inset-0 -z-10 bg-gradient-to-l from-transparent via-white/85 to-white"></div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-terza-teal">{ubicacionesTeaser.eyebrow}</p>
        <h2 class="mt-2 max-w-xs text-3xl font-bold leading-[1.15] text-terza-teal md:text-4xl xl:text-5xl">
          {ubicacionesTeaser.title.split(' ').slice(0, -1).join(' ')} <span class="text-[#a8d900]">{ubicacionesTeaser.title.split(' ').at(-1)}</span>
        </h2>
        <p class="mt-3 max-w-xs text-sm text-terza-ink/70">{ubicacionesTeaser.description}</p>
        <a href={ubicacionesTeaser.cta.href} class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-terza-teal px-6 py-2.5 text-sm font-semibold text-white hover:bg-terza-teal-dark">
          {ubicacionesTeaser.cta.label} →
        </a>
      </div>
    </div>
  </section>
</Layout>
