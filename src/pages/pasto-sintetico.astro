---
// Misma estructura y textos que terza.com/pasto-sintetico, con el diseño de las páginas de línea (ver Deck y Lambrín).
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../components/linea/LineaHero.astro';
import BleedSplit from '../components/linea/BleedSplit.astro';
import FaqAccordion from '../components/linea/FaqAccordion.astro';
import ContactBand from '../components/linea/ContactBand.astro';
import data from '../data/pasto-sintetico.json';
import heroImg from '../assets/images/pasto-sintetico/header.jpg';
import catalogoImg from '../assets/images/cat-pasto-sintetico.webp';

const { hero, intro, calidad, aplicaciones, ventajas, porQue, conoceMas, servicios, tipos, catalogo, video, disenaCancha, faqs, cierre } = data;

// Fotos e íconos de terza.com/pasto-sintetico
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/images/pasto-sintetico/*.webp', { eager: true });
const img = (name: string) => assets[`../assets/images/pasto-sintetico/${name}.webp`].default;

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Familia con su perro sobre pasto sintético Terza" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <p class="mt-5 text-lg text-black xl:text-xl">{intro.description}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel={cta.href.startsWith('http') ? 'noopener' : undefined} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- La mejor calidad... (en terza.com es un carrusel de modelos; aquí la textura y los nombres) -->
  <BleedSplit image={img('modelo-garden36')} alt="Textura del pasto sintético modelo Garden 36" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{calidad.title}</h2>
    <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl">{calidad.description}</p>
    <ul class="mt-8 flex max-w-xl flex-wrap gap-2">
      {calidad.modelos.map((m) => (
        <li class="rounded-full border border-white/30 px-4 py-1 text-sm font-bold uppercase tracking-wide text-white">{m}</li>
      ))}
    </ul>
  </BleedSplit>

  <!-- Aplicaciones: tarjetas con foto -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
    <h2 class="text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{aplicaciones.title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
      {aplicaciones.items.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-[28px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <div class="overflow-hidden">
            <Image src={img(item.image)} alt={item.alt} class="aspect-[4/3] w-full scale-110 object-cover" />
          </div>
          <div class="p-7 xl:p-8">
            <h3 class="text-2xl font-bold leading-tight text-terza-teal">{item.title}</h3>
            <p class="mt-3 text-black xl:text-lg">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Ventajas: franja verde claro con tarjetas blancas (como en Lambrín) -->
  <section class="bg-terza-lime-pale">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
      <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{ventajas.title}</h2>
      <ul class="mx-auto mt-10 grid max-w-[1000px] grid-cols-1 gap-x-12 gap-y-5 md:grid-cols-2">
        {ventajas.items.map((v) => (
          <li class="flex items-center gap-4 rounded-[20px] bg-white px-5 py-4 shadow-[0_4px_18px_rgba(0,0,0,0.06)]">
            <Image src={img(v.icon)} alt="" class="h-12 w-12 shrink-0" width={96} height={96} />
            <span class="text-lg font-medium text-black xl:text-xl">{v.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ¿Por qué optar...? -->
  <div class="mt-16 xl:mt-24">
    <BleedSplit image={img('img-04')} alt="Minigolf con pasto sintético Terza" imageSide="left" tone="teal">
      <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{porQue.title}</h2>
      <ul class="mt-6 max-w-xl space-y-3 text-lg text-white/85 xl:text-xl">
        {porQue.items.map((item) => (
          <li class="flex items-start gap-3"><span class="mt-[0.6em] h-2 w-2 shrink-0 rounded-full bg-terza-lime"></span>{item}</li>
        ))}
      </ul>
    </BleedSplit>
  </div>

  <!-- Conoce más -->
  <section class="mx-auto max-w-[1100px] px-6 py-16 text-center md:px-12 xl:py-24">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl" set:html={conoceMas.title} />
    <p class="mx-auto mt-6 max-w-[820px] text-lg text-black xl:text-xl">{conoceMas.description}</p>
  </section>

  <!-- Proyectos, instalación y mantenimiento: zigzag con la fila del medio en gris -->
  <section class="flex flex-col gap-14 pb-16 xl:gap-20 xl:pb-24">
    {servicios.map((item, i) => (
      <BleedSplit image={img(item.image)} alt={item.alt} imageSide={i % 2 === 0 ? 'left' : 'right'} tone={i === 1 ? 'mist' : 'white'}>
        <h3 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{item.title}</h3>
        <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{item.description}</p>
      </BleedSplit>
    ))}
  </section>

  <!-- Tipos de pasto -->
  <section class="bg-terza-mist">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
      <h2 class="text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl" set:html={tipos.title} />
      <div class="mx-auto mt-12 grid max-w-[1200px] grid-cols-1 gap-6 md:grid-cols-2 xl:gap-8">
        {tipos.items.map((t) => (
          <article class="flex flex-col gap-6 rounded-[28px] bg-white p-7 shadow-[0_4px_18px_rgba(0,0,0,0.08)] sm:flex-row sm:items-start xl:p-8">
            <Image src={img(t.image)} alt={t.title} class="h-28 w-28 shrink-0 rounded-full" width={160} height={160} />
            <div>
              <h3 class="text-2xl font-bold leading-tight text-terza-teal">{t.title}</h3>
              <ul class="mt-4 space-y-2 text-black xl:text-lg">
                {t.points.map((p) => (
                  <li class="flex items-start gap-3"><span class="mt-[0.6em] h-2 w-2 shrink-0 rounded-full bg-terza-lime"></span>{p}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 flex justify-center">
        <a href={tipos.cta.href} class="inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
          {tipos.cta.label} <Fragment set:html={arrow} />
        </a>
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={catalogoImg} alt="Jardín con pasto sintético Terza" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" />
  </section>

  <!-- Video de YouTube -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="rounded-[28px] bg-terza-lime-pale px-6 py-12 text-center md:px-12 xl:py-16">
      <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{video.title}</h2>
      <p class="mx-auto mt-4 max-w-[820px] text-lg text-black xl:text-xl">{video.description}</p>
      <div class="mt-10 flex justify-center">
        <iframe src={video.src} title={video.title} width="900" height="506" class="aspect-video w-full max-w-[900px] rounded-[20px] border-0 shadow-[0_4px_18px_rgba(0,0,0,0.08)]" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <!-- Diseña tu cancha -->
  <div class="mt-16 xl:mt-24">
    <BleedSplit image={img('img-09')} alt="Mujer estirando sobre una cancha de pasto sintético" imageSide="left">
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{disenaCancha.title}</h2>
      <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{disenaCancha.description}</p>
      <ul class="mt-8 grid max-w-xl grid-cols-3 gap-x-4 gap-y-5 sm:grid-cols-5">
        {disenaCancha.colores.map((c) => (
          <li class="flex flex-col items-center text-center">
            <Image src={img(c.image)} alt={`Pasto sintético color ${c.label}`} class="h-14 w-14 rounded-full shadow-[0_4px_18px_rgba(0,0,0,0.08)]" width={78} height={78} />
            <span class="mt-2 text-sm font-medium leading-tight text-black">{c.label}</span>
          </li>
        ))}
      </ul>
    </BleedSplit>
  </div>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
