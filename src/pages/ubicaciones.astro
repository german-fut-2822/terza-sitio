---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import data from '../data/ubicaciones.json';
import heroImg from '../assets/images/ubicaciones-hero.webp';

import oficinaCentral from '../assets/images/oficina-central.webp';
import showroomCubes from '../assets/images/showroom-cubes.webp';
import oficinaCdmx from '../assets/images/oficina-cdmx.webp';
import oficinaGdl from '../assets/images/oficina-gdl.webp';
import oficinaPuebla from '../assets/images/oficina-puebla.webp';

const images: Record<string, ImageMetadata> = {
  'oficina-central': oficinaCentral,
  'showroom-cubes': showroomCubes,
  'oficina-cdmx': oficinaCdmx,
  'oficina-gdl': oficinaGdl,
  'oficina-puebla': oficinaPuebla,
};

const { hero, locations } = data;
---

<Layout title={data.seo.title} description={data.seo.description}>
  <section class="relative isolate flex min-h-[460px] items-end overflow-hidden xl:min-h-[560px]">
    <Image src={heroImg} alt="Equipo Terza en planta" class="absolute inset-0 -z-10 h-full w-full object-cover" width={2000} height={1200} />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-black/10"></div>

    <div class="mx-auto w-full max-w-[1728px] px-6 py-14 text-white md:px-12 xl:px-[72px]">
      <h1 class="text-4xl font-bold md:text-5xl xl:text-7xl">{hero.title}</h1>
      <p class="mt-3 max-w-sm whitespace-pre-line text-lg text-white/85">{hero.description}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1728px] grid-cols-1 gap-6 px-6 py-12 md:grid-cols-3 md:px-12 lg:grid-cols-5 xl:px-[72px] xl:py-14">
    {locations.map((loc: { tag: string; name: string; address: string; phone: string; image: string }, i: number) => (
      <div class="flex flex-col overflow-hidden rounded-[28px]">
        <div class="relative h-48 xl:h-56">
          <Image src={images[loc.image]} alt={loc.name} class="h-full w-full object-cover" width={400} height={300} />
          <span class="absolute left-0 top-6 flex h-11 w-[72%] items-center rounded-r-full bg-terza-lime pl-6 text-base font-bold text-terza-ink xl:top-7 xl:h-12 xl:pl-7 xl:text-lg">
            {loc.tag}
          </span>
        </div>
        <div class={`flex flex-1 flex-col justify-center p-5 text-white ${i === 0 ? 'bg-terza-teal' : 'bg-[#686868]'}`}>
          <p class="text-lg font-semibold">{loc.name}</p>
          <p class="mt-1.5 text-sm text-white/75">{loc.address}</p>
          <p class="mt-3 font-semibold">{loc.phone}</p>
        </div>
      </div>
    ))}
  </section>
</Layout>
