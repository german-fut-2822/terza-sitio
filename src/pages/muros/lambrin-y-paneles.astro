---
// Misma estructura y textos que terza.com/lambrin-pvc, con el diseño de las páginas de línea (ver Alfombras y Deck).
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../../components/linea/LineaHero.astro';
import BleedSplit from '../../components/linea/BleedSplit.astro';
import FaqAccordion from '../../components/linea/FaqAccordion.astro';
import ContactBand from '../../components/linea/ContactBand.astro';
import data from '../../data/lambrin.json';
import heroImg from '../../assets/images/lambrin/header.jpg';

const { hero, intro, ideales, beneficios, porQue, mantenimiento, catalogo, faqs, cierre } = data;

// Fotos e íconos de terza.com/lambrin-pvc
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/lambrin/*.png', { eager: true });
const img = (name: string) => assets[`../../assets/images/lambrin/${name}.png`].default;

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Sala con lambrín de madera Terza" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel={cta.href.startsWith('http') ? 'noopener' : undefined} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- Ideales para... -->
  <BleedSplit image={img('img-01')} alt="Habitación con lambrín Terza" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{ideales.title}</h2>
    <ul class="mt-6 space-y-2 text-lg text-white/85 xl:text-xl">
      {ideales.items.map((item) => (
        <li class="flex items-center gap-3"><span class="h-2 w-2 shrink-0 rounded-full bg-terza-lime"></span>{item}</li>
      ))}
    </ul>
    <p class="mt-6 text-lg text-white/85 xl:text-xl">{ideales.closing}</p>
  </BleedSplit>

  <!-- Beneficios: franja verde claro a todo el ancho (como en Deck) -->
  <section class="mt-16 bg-terza-lime-pale xl:mt-24">
    <div class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-20">
      <h2 class="text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{beneficios.title}</h2>
      <ul class="mx-auto mt-10 grid max-w-[1000px] grid-cols-1 gap-x-12 gap-y-5 md:grid-cols-2">
        {beneficios.items.map((b) => (
          <li class="flex items-center gap-4 rounded-[20px] bg-white px-5 py-4 shadow-[0_4px_18px_rgba(0,0,0,0.06)]">
            <Image src={img(b.icon)} alt="" class="h-12 w-12 shrink-0" width={96} height={96} />
            <span class="text-lg font-medium text-black xl:text-xl">{b.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ¿Por qué optar...? Tarjetas con foto -->
  <section class="mx-auto max-w-[1728px] px-6 py-16 md:px-12 xl:px-[72px] xl:py-24">
    <h2 class="text-center text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{porQue.title}</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 xl:gap-8">
      {porQue.items.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-[28px] bg-white shadow-[0_4px_18px_rgba(0,0,0,0.08)]">
          <div class="overflow-hidden">
            <Image src={img(item.image)} alt={item.title} class="aspect-[4/3] w-full scale-110 object-cover" />
          </div>
          <div class="p-7 xl:p-8">
            <h3 class="text-2xl font-bold leading-tight text-terza-teal">{item.title}</h3>
            <p class="mt-3 text-black xl:text-lg">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Mantenimiento: franja gris -->
  <section class="bg-terza-mist">
    <div class="mx-auto max-w-[1100px] space-y-4 px-6 py-14 text-center md:px-12 xl:py-16">
      {mantenimiento.map((p) => <p class="text-lg text-black xl:text-xl">{p}</p>)}
    </div>
  </section>

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={heroImg} alt="Lambrín y paneles Terza" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" />
  </section>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
