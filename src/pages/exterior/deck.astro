---
// Misma estructura y textos que terza.com/pisos-deck, con el diseño de las páginas de línea (ver Alfombras).
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LineaHero from '../../components/linea/LineaHero.astro';
import BleedSplit from '../../components/linea/BleedSplit.astro';
import IconCards from '../../components/linea/IconCards.astro';
import FaqAccordion from '../../components/linea/FaqAccordion.astro';
import ContactBand from '../../components/linea/ContactBand.astro';
import data from '../../data/deck.json';
import heroImg from '../../assets/images/deck/header.jpg';
import catalogoImg from '../../assets/images/cat-deck.webp';

const { hero, intro, porQue, conoceMas, beneficios, variedad, cuidados, catalogo, video, faqs, cierre } = data;

// Fotos e íconos de terza.com/pisos-deck
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/deck/*.webp', { eager: true });
const img = (name: string) => assets[`../../assets/images/deck/${name}.webp`].default;
const withIcons = (items: { icon: string; title: string; description: string }[]) => items.map((i) => ({ ...i, icon: img(i.icon) }));

const arrow = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---

<Layout title={data.seo.title} description={data.seo.description}>
  <LineaHero image={heroImg} alt="Alberca con piso deck Terza" title={hero.title} subtitle={hero.subtitle} />

  <!-- Intro centrada con botones -->
  <section class="mx-auto max-w-[1100px] px-6 py-14 text-center md:px-12 xl:py-20">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{intro.title}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {intro.ctas.map((cta, i) => (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel={cta.href.startsWith('http') ? 'noopener' : undefined} class:list={['inline-flex items-center gap-2 rounded-full px-7 py-1.5 text-base font-bold', i === 0 ? 'bg-terza-lime text-terza-ink hover:brightness-95' : 'bg-terza-teal text-white hover:bg-terza-teal-dark']}>
          {cta.label} <Fragment set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- ¿Por qué optar...? -->
  <BleedSplit image={img('img-01')} alt="Patio con piscina con piso deck de Terza" tone="teal">
    <h2 class="text-3xl font-bold leading-[1.15] md:text-4xl xl:text-5xl">{porQue.title}</h2>
    {porQue.paragraphs.map((p) => <p class="mt-5 max-w-xl text-lg text-white/85 xl:text-xl">{p}</p>)}
  </BleedSplit>

  <!-- Conoce más: zigzag con la fila del medio en gris -->
  <section class="pt-16 xl:pt-24">
    <h2 class="px-6 text-center text-3xl font-bold text-black md:text-4xl xl:text-5xl">{conoceMas.title}</h2>
    <div class="mt-12 flex flex-col gap-14 xl:mt-16 xl:gap-20">
      {conoceMas.items.map((item, i) => (
        <BleedSplit image={img(item.image)} alt={item.alt} imageSide={i % 2 === 0 ? 'right' : 'left'} tone={i === 1 ? 'mist' : 'white'} zoom={false}>
          <h3 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{item.title}</h3>
          <p class="mt-5 max-w-xl text-lg text-black xl:text-xl">{item.description}</p>
        </BleedSplit>
      ))}
    </div>
  </section>

  <div class="mt-16 xl:mt-24">
    <IconCards title={beneficios.title} items={withIcons(beneficios.items)} tone="lime" />
  </div>

  <!-- Variedad -->
  <section class="mx-auto max-w-[1100px] px-6 py-16 text-center md:px-12 xl:py-24">
    <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl" set:html={variedad.title} />
    <p class="mx-auto mt-6 max-w-[760px] text-lg text-black xl:text-xl">{variedad.description}</p>
  </section>

  <IconCards title={cuidados.title} items={withIcons(cuidados.items)} tone="mist" />

  <!-- Catálogo -->
  <section class="mx-auto grid max-w-[1728px] grid-cols-1 items-center gap-10 px-6 py-16 md:px-12 lg:grid-cols-2 xl:gap-20 xl:px-[72px] xl:py-24">
    <div>
      <h2 class="text-3xl font-bold leading-[1.15] text-black md:text-4xl xl:text-5xl">{catalogo.title}</h2>
      <a href={catalogo.cta.href} class="mt-8 inline-flex items-center gap-2 rounded-full bg-terza-lime px-7 py-1.5 text-base font-bold text-terza-ink hover:brightness-95">
        {catalogo.cta.label} <Fragment set:html={arrow} />
      </a>
    </div>
    <Image src={catalogoImg} alt="Terraza con piso deck Terza" class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-[0_4px_18px_rgba(0,0,0,0.08)]" />
  </section>

  <!-- Diseña tu espacio (video) -->
  <section class="mx-auto max-w-[1728px] px-6 md:px-12 xl:px-[72px]">
    <div class="rounded-[28px] bg-terza-lime-pale px-6 py-12 text-center md:px-12 xl:py-16">
      <h2 class="text-3xl font-bold text-black md:text-4xl xl:text-5xl">{video.title}</h2>
      <p class="mx-auto mt-4 max-w-[820px] text-lg text-black xl:text-xl">{video.description}</p>
      <div class="mt-10 flex justify-center">
        <iframe src={video.src} title={video.title} width="500" height="500" class="aspect-square w-full max-w-[500px] rounded-[20px] border-0 shadow-[0_4px_18px_rgba(0,0,0,0.08)]" scrolling="no" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <FaqAccordion title={faqs.title} items={faqs.items} />

  <ContactBand title={cierre.title} cta={cierre.cta} />
</Layout>
